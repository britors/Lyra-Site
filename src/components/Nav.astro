---
const links = [
  { href: '/lyro', label: 'Lyro' },
  { href: '/prosa', label: 'Prosa' },
  { href: '/fina', label: 'Fina' },
  { href: '/vega', label: 'Vega' },
  { href: '/download', label: 'Download' },
  { href: '/comunidade', label: 'Comunidade' },
  { href: '/contribuir', label: 'Contribuir' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>Lyra OS</span>
    </a>
    <nav aria-label="Navegação principal">
      <ul class="nav__links">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary nav__cta" href="/download">Baixar</a>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--lyra-border);
    position: sticky;
    top: 0;
    background: rgba(13, 13, 31, 0.85);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--lyra-star);
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav__links {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav__links a {
    color: var(--lyra-star-dim);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--lyra-star);
  }

  .nav__cta {
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .nav__inner {
      flex-wrap: wrap;
    }

    .nav__links {
      order: 3;
      width: 100%;
      gap: 1rem;
      justify-content: center;
    }
  }
</style>
