---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'Tudo num só lugar',
    description: 'Instale programas de vários lugares diferentes, sem precisar procurar em sites separados.',
  },
  {
    title: 'Volte no tempo',
    description: 'Algo deu errado? Um ponto de restauração devolve o sistema para antes do problema.',
    id: 'restauracao',
  },
  {
    title: 'Drivers e kernel, num clique',
    description: 'Troque drivers de vídeo e versões de kernel sem tocar num terminal.',
  },
  {
    title: 'Rede e firewall, simplificados',
    description: 'Configure sua rede e proteja seu sistema por telas claras, não por linhas de comando.',
  },
];
---

<BaseLayout
  title="Vega — a estrela que cuida do seu sistema"
  description="Vega é o centro de controle do Lyra OS: instale programas, volte no tempo, troque drivers e cuide da rede, tudo sem terminal."
>
  <section class="section">
    <div class="container">
      <h1>Vega — a estrela que cuida do seu sistema</h1>
      <p class="subtitle gradient-text">Um centro de controle completo. Sem terminal.</p>

      <div class="feature-grid">
        {features.map((feature) => (
          <div class="card" id={feature.id}>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>

      <img
        class="vega-shot"
        src="/images/vega.png"
        alt="Tela do módulo de software do Vega"
        loading="lazy"
        decoding="async"
      />

      <p class="highlight">Nenhuma outra distro tem isso.</p>

      <div class="card availability">
        <h3>Já usa outra distribuição Linux?</h3>
        <p>
          O Vega também funciona fora do Lyra OS, em outras distribuições
          Linux. Você não precisa trocar de distro para ter esse centro
          de controle.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/download">Baixar o Lyra OS</a>
          <a class="btn btn--secondary" href="https://github.com/britors/Vega">
            Instalar o Vega
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .subtitle {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 2.5rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .feature-grid p {
    color: var(--lyra-star-dim);
    margin: 0;
  }

  .vega-shot {
    width: 100%;
    border-radius: var(--radius-card);
    border: 1px solid var(--lyra-border);
    box-shadow: 0 12px 32px rgba(10, 12, 30, 0.55);
    margin: 0 0 2rem;
  }

  .highlight {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    margin: 2.5rem 0;
  }

  .availability p {
    color: var(--lyra-star-dim);
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
