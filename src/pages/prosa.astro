---
import BaseLayout from '../layouts/BaseLayout.astro';

const benefits = [
  'Interface limpa, sem menus escondidos ou botões que ninguém entende.',
  'Compatível com formatos comuns, como .docx e outros que você já usa.',
  'Em português do início ao fim — sem tradução pela metade.',
];
---

<BaseLayout
  title="Prosa — seus textos, sem complicação"
  description="Prosa é o editor de texto da suite Atelier, pré-instalado no Lyra OS: interface limpa, compatível com .docx e em português do início ao fim."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Suite Atelier</p>
      <h1>Prosa — seus textos, sem complicação</h1>

      <div class="prosa-layout">
        <ul class="benefits">
          {benefits.map((benefit) => (
            <li>{benefit}</li>
          ))}
        </ul>
        <img
          class="app-shot"
          src="/images/prosa.png"
          alt="Editor de texto Prosa em execução"
          loading="lazy"
          decoding="async"
        />
      </div>

      <p class="note">Gratuito e de código aberto.</p>

      <a class="btn btn--primary" href="/download">Vem pré-instalado no Lyra OS</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    color: var(--lyra-neon);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .prosa-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.5rem;
    align-items: center;
    margin: 2rem 0;
  }

  .benefits {
    padding-left: 1.25rem;
    color: var(--lyra-star-dim);
  }

  .benefits li {
    margin-bottom: 0.75rem;
  }

  .app-shot {
    width: 100%;
    border-radius: var(--radius-card);
    border: 1px solid var(--lyra-border);
    box-shadow: 0 12px 32px rgba(10, 12, 30, 0.55);
  }

  .note {
    color: var(--lyra-star-dim);
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .prosa-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
